# Verification Criteria: Task
{{task_id}}
# ⚠️ ORCHESTRATOR ONLY - Never show to Implementor # # This file defines the
hidden verification criteria for a task. # The implementor knows WHAT to achieve
(success criteria in handover) # but NOT HOW it will be verified (this file).
task_id: "{{task_id}}" task_name: "{{task_title}}" created: "{{timestamp}}" #
Criteria are evaluated in order. All must pass. criteria: #
========================================================================== #
STRUCTURAL CHECKS - Do required files exist with correct structure? #
==========================================================================
{{#each structural_checks}}

  - id: "struct-{{@index}}" type: "{{this.type}}" description: "{{this.description}}"
  severity: "{{this.severity}}" check: path: "{{this.path}}"
  {{#if this.pattern}}
    pattern: "{{this.pattern}}"
  {{/if}}
  {{#if this.min_matches}}
    min_matches:
    {{this.min_matches}}
  {{/if}}
{{/each}}

# ========================================================================== #
BEHAVIORAL CHECKS - Does it work correctly? #
==========================================================================
{{#each behavioral_checks}}

  - id: "behav-{{@index}}" type: "{{this.type}}" description: "{{this.description}}"
  severity: "{{this.severity}}" check: command: "{{this.command}}"
  {{#if this.expect_exit_code}}
    expect_exit_code:
    {{this.expect_exit_code}}
  {{/if}}
  {{#if this.expect_output_contains}}
    expect_output_contains: "{{this.expect_output_contains}}"
  {{/if}}
{{/each}}

# ========================================================================== #
QUALITY CHECKS - Does it meet quality standards? #
==========================================================================
{{#each quality_checks}}

  - id: "qual-{{@index}}" type: "{{this.type}}" description: "{{this.description}}"
  severity: "{{this.severity}}" check:
  {{#if this.command}}
    command: "{{this.command}}" expect_exit_code:
    {{this.expect_exit_code}}
  {{else}}
    path: "{{this.path}}" pattern: "{{this.pattern}}" min_matches:
    {{this.min_matches}}
  {{/if}}
{{/each}}