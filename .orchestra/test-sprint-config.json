{
  "sprint": {
    "id": "test-sprint-001",
    "name": "Test Sprint - Agent Workflow Validation",
    "spec_path": "spec/readme.md"
  },
  "environment": {
    "test_command": "npm test",
    "test_file_pattern": "test/**/*.test.ts",
    "source_base_dir": "src"
  },
  "phases": [
    {
      "phase_id": "phase-1",
      "phase_name": "Documentation Tasks"
    },
    {
      "phase_id": "phase-2",
      "phase_name": "Code Quality Tasks"
    }
  ],
  "tasks": [
    {
      "task_id": 1,
      "phase_id": "phase-1",
      "title": "Add JSDoc to OrchestraLogger",
      "description": "Add comprehensive JSDoc documentation to the OrchestraLogger class in extension/src/utils/logger.ts. Document all public methods with @param, @returns, and @example tags.",
      "category": "REFACTOR",
      "dependencies": [],
      "verification": {
        "structural_checks": [
          {
            "description": "JSDoc comments present on public methods",
            "path": "extension/src/utils/logger.ts",
            "pattern": "/\\*\\*[\\s\\S]*?@param",
            "min_matches": 3,
            "severity": "BLOCKING"
          }
        ],
        "quality_checks": [
          {
            "description": "Has @returns documentation",
            "path": "extension/src/utils/logger.ts",
            "pattern": "@returns",
            "min_matches": 2,
            "severity": "MAJOR"
          }
        ]
      }
    },
    {
      "task_id": 2,
      "phase_id": "phase-1",
      "title": "Create TESTING.md documentation",
      "description": "Create a TESTING.md file in the repository root that documents how to run tests, test structure, and testing conventions used in the project.",
      "category": "INFRASTRUCTURE",
      "dependencies": [],
      "verification": {
        "structural_checks": [
          {
            "description": "TESTING.md file exists",
            "path": "TESTING.md",
            "pattern": ".",
            "min_matches": 1,
            "severity": "BLOCKING"
          }
        ],
        "quality_checks": [
          {
            "description": "Contains npm test command",
            "path": "TESTING.md",
            "pattern": "npm test",
            "min_matches": 1,
            "severity": "MAJOR"
          },
          {
            "description": "Contains vitest reference",
            "path": "TESTING.md",
            "pattern": "[Vv]itest",
            "min_matches": 1,
            "severity": "MINOR"
          }
        ]
      }
    },
    {
      "task_id": 3,
      "phase_id": "phase-2",
      "title": "Add inline comments to ConfigService",
      "description": "Add explanatory inline comments to the ConfigService class in extension/src/config/ConfigService.ts. Focus on explaining the configuration resolution logic and any non-obvious behavior.",
      "category": "REFACTOR",
      "dependencies": [1],
      "verification": {
        "structural_checks": [
          {
            "description": "Inline comments added",
            "path": "extension/src/config/ConfigService.ts",
            "pattern": "//.*[A-Z]",
            "min_matches": 5,
            "severity": "BLOCKING"
          }
        ]
      }
    }
  ]
}
