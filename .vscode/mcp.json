{
  // DEVELOPMENT CONFIGURATION
  // This points to the local workspace MCP server for dogfooding.
  // For production, use the McpServerDefinitionProvider from the extension
  // or update paths to point to installed extension.
  "servers": {
    "orchestra-orchestrator": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/extension/dist/mcp-server/index.js",
        "--role=orchestrator"
      ],
      "env": {
        "ORCHESTRA_WORKSPACE": "${workspaceFolder}"
      }
    },
    "orchestra-implementor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/extension/dist/mcp-server/index.js",
        "--role=implementor"
      ],
      "env": {
        "ORCHESTRA_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
