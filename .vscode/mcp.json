{
  "servers": {
    "orchestra-orc2": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/dist/mcp-server/index.js",
        "--role=orchestrator"
      ],
      "env": {
        "ORCHESTRA_WORKSPACE": "${workspaceFolder}"
      }
    },
    "orchestra-imp2": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/dist/mcp-server/index.js",
        "--role=implementor"
      ],
      "env": {
        "ORCHESTRA_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
