# Source files (bundled into dist/extension.js)
.vscode/**
.vscode-test/**
src/**
scripts/**
test/**

# Build artifacts and config
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
eslint.config.js
vitest.config.ts
esbuild.config.js
**/*.map
**/*.ts
!dist/**
!agents/**
!resources/**

# Exclude root node_modules (extension is bundled)
node_modules/**

# Exclude unused drizzle-orm drivers from dist (we only use sqlite)
dist/node_modules/drizzle-orm/pg-core/**
dist/node_modules/drizzle-orm/mysql-core/**
