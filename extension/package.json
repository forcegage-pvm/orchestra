{
  "name": "orchestra-extension",
  "displayName": "Orchestra",
  "description": "AI agent task orchestration for VS Code",
  "version": "0.8.1",
  "publisher": "forcegage",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcegage-pvm/orchestra.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "orchestration",
    "ai",
    "agents",
    "task management",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "orchestra.mcp-servers",
        "label": "Orchestra MCP Servers"
      }
    ],
    "configuration": {
      "title": "Orchestra",
      "properties": {
        "orchestra.autoStartMCP": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start MCP servers on extension activation"
        },
        "orchestra.updateInterval": {
          "type": "number",
          "default": 500,
          "description": "Database update debounce interval in milliseconds"
        },
        "orchestra.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for Orchestra output channel"
        },
        "orchestra.models.orchestrator": {
          "type": "string",
          "default": "claude-opus-4.5",
          "description": "AI model to use for the Orchestrator agent (e.g., claude-opus-4.5)"
        },
        "orchestra.models.implementor": {
          "type": "string",
          "default": "claude-sonnet-4.5",
          "description": "AI model to use for the Implementor agent (e.g., claude-sonnet-4.5)"
        },
        "orchestra.models.controller": {
          "type": "string",
          "default": "claude-opus-4.5",
          "description": "AI model to use for the Controller agent (e.g., claude-opus-4.5)"
        },
        "orchestra.agents.orchestrator": {
          "type": "string",
          "default": "orchestra.orchestrator",
          "description": "Agent mode identifier for the Orchestrator role"
        },
        "orchestra.agents.implementor": {
          "type": "string",
          "default": "orchestra.implementor",
          "description": "Agent mode identifier for the Implementor role"
        },
        "orchestra.agents.controller": {
          "type": "string",
          "default": "orchestra.controller",
          "description": "Agent mode identifier for the Controller role"
        }
      }
    },
    "commands": [
      {
        "command": "orchestra.openDashboard",
        "title": "Orchestra: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "orchestra.refreshStatus",
        "title": "Orchestra: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "orchestra.filterSprints",
        "title": "Orchestra: Filter Sprints",
        "icon": "$(filter)"
      },
      {
        "command": "orchestra.openSprintSettings",
        "title": "Orchestra: Open Sprint Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "orchestra.openTaskDetail",
        "title": "Orchestra: Open Task Detail",
        "icon": "$(file-text)"
      },
      {
        "command": "orchestra.invokeOrchestrator",
        "title": "Orchestra: Invoke Orchestrator Agent",
        "icon": "$(robot)"
      },
      {
        "command": "orchestra.invokeImplementor",
        "title": "Orchestra: Invoke Implementor Agent",
        "icon": "$(tools)"
      },
      {
        "command": "orchestra.startTask",
        "title": "Start Task",
        "icon": "$(play)"
      },
      {
        "command": "orchestra.playTask",
        "title": "Play Task",
        "icon": "$(play)"
      },
      {
        "command": "orchestra.installMcpServers",
        "title": "Orchestra: Install MCP Servers",
        "icon": "$(plug)"
      },
      {
        "command": "orchestra.initializeWorkspace",
        "title": "Orchestra: Initialize Workspace",
        "icon": "$(add)"
      },
      {
        "command": "orchestra.showVersion",
        "title": "Orchestra: Show Version & Migration Status",
        "icon": "$(info)"
      },
      {
        "command": "orchestra.deEscalateTask",
        "title": "De-escalate Task",
        "icon": "$(issues)"
      },
      {
        "command": "orchestra.moveToGateCheck",
        "title": "Move to Gate Check (Re-verify)",
        "icon": "$(debug-restart)"
      },
      {
        "command": "orchestra.moveToImplement",
        "title": "Move to Implement (Re-do)",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "orchestra.forceComplete",
        "title": "Force Complete (Override)",
        "icon": "$(check-all)"
      },
      {
        "command": "orchestra.reopenTask",
        "title": "Reopen Task (Reset to Pending)",
        "icon": "$(history)"
      },
      {
        "command": "orchestra.setActiveSprint",
        "title": "Set as Active Sprint",
        "icon": "$(star)"
      },
      {
        "command": "orchestra.archiveSprint",
        "title": "Archive Sprint",
        "icon": "$(archive)"
      },
      {
        "command": "orchestra.unarchiveSprint",
        "title": "Unarchive Sprint",
        "icon": "$(arrow-up)"
      },
      {
        "command": "orchestra.startAgent",
        "title": "Orchestra: Start Agent",
        "icon": "$(play)"
      },
      {
        "command": "orchestra.pauseAgent",
        "title": "Orchestra: Pause Agent",
        "icon": "$(debug-pause)"
      },
      {
        "command": "orchestra.stopAgent",
        "title": "Orchestra: Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "orchestra.resumeAgent",
        "title": "Orchestra: Resume Agent",
        "icon": "$(debug-continue)"
      },
      {
        "command": "orchestra.launchControllerForSprint",
        "title": "Review Sprint Configuration",
        "icon": "$(play)"
      },
      {
        "command": "orchestra.launchControllerAgent",
        "title": "Launch Controller Agent",
        "icon": "$(robot)"
      },
      {
        "command": "orchestra.openCodeReviewSummary",
        "title": "Orchestra: Open Code Review Summary",
        "icon": "$(list-unordered)"
      },
      {
        "command": "orchestra.runAdHocReview",
        "title": "Orchestra: Run Ad-hoc Code Review",
        "icon": "$(play)"
      },
      {
        "command": "orchestra.fixCodeReviewIssues",
        "title": "Orchestra: Fix Code Review Issues",
        "icon": "$(tools)"
      },
      {
        "command": "orchestra.verifyCodeReviewFixes",
        "title": "Orchestra: Verify Code Review Fixes",
        "icon": "$(checklist)"
      },
      {
        "command": "orchestra.escalateRejectedReview",
        "title": "Orchestra: Escalate Rejected Review",
        "icon": "$(warning)"
      },
      {
        "command": "orchestra.reReviewTask",
        "title": "Orchestra: Re-review Task",
        "icon": "$(refresh)"
      },
      {
        "command": "orchestra.runCodeReview",
        "title": "Orchestra: Run Code Review for Task",
        "icon": "$(checklist)"
      },
      {
        "command": "orchestra.prepareCodeReviewFixTask",
        "title": "Orchestra: Prepare Code Review Fixes",
        "icon": "$(tools)"
      },
      {
        "command": "orchestra.implementCodeReviewFixTask",
        "title": "Orchestra: Implement Code Review Fixes",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "orchestra.playTask",
        "key": "enter",
        "when": "view == orchestra.sprintExplorer && listFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orchestra-explorer",
          "title": "Orchestra",
          "icon": "$(symbol-misc)"
        }
      ]
    },
    "views": {
      "orchestra-explorer": [
        {
          "id": "orchestra.currentTask",
          "name": "Current Task",
          "type": "webview"
        },
        {
          "id": "orchestra.sprintExplorer",
          "name": "Sprint Explorer",
          "type": "tree"
        },
        {
          "id": "orchestra.codeReview",
          "name": "Code Review",
          "type": "tree"
        },
        {
          "id": "orchestra.workflowControls",
          "name": "Workflow Controls",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "orchestra.sprintExplorer",
        "contents": "No Orchestra workspace detected.\n\n[Initialize Workspace](command:orchestra.initializeWorkspace)\n\nThis will create the .orchestra folder and database for AI agent task orchestration.",
        "when": "!orchestra.hasWorkspace"
      },
      {
        "view": "orchestra.sprintExplorer",
        "contents": "No active sprint.\n\nUse the Orchestra MCP server to configure a sprint, or create one manually.\n\n[Install MCP Servers](command:orchestra.installMcpServers)",
        "when": "orchestra.hasWorkspace && !orchestra.hasActiveSprint"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "orchestra.refreshStatus",
          "when": "view == orchestra.sprintExplorer",
          "group": "navigation"
        },
        {
          "command": "orchestra.filterSprints",
          "when": "view == orchestra.sprintExplorer",
          "group": "navigation"
        },
        {
          "command": "orchestra.openSprintSettings",
          "when": "view == orchestra.sprintExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "orchestra.launchControllerForSprint",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^sprint-pending-review/",
          "group": "inline"
        },
        {
          "command": "orchestra.setActiveSprint",
          "when": "view == orchestra.sprintExplorer && viewItem == sprint-inactive",
          "group": "inline"
        },
        {
          "command": "orchestra.archiveSprint",
          "when": "view == orchestra.sprintExplorer && viewItem == sprint-inactive",
          "group": "inline@1"
        },
        {
          "command": "orchestra.unarchiveSprint",
          "when": "view == orchestra.sprintExplorer && viewItem == sprint-archived",
          "group": "inline@1"
        },
        {
          "command": "orchestra.setActiveSprint",
          "when": "view == orchestra.sprintExplorer && viewItem == sprint-inactive",
          "group": "navigation"
        },
        {
          "command": "orchestra.openTaskDetail",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-/",
          "group": "navigation"
        },
        {
          "command": "orchestra.playTask",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-(pending|implement|verify|verify_failed|gate_check|escalated|pending_handover_review|handover_review_failed|prepare)$/",
          "group": "inline@1"
        },
        {
          "command": "orchestra.startTask",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-(pending|implement)$/",
          "group": "inline@0"
        },
        {
          "command": "orchestra.deEscalateTask",
          "when": "view == orchestra.sprintExplorer && viewItem == task-escalated",
          "group": "inline@1"
        },
        {
          "command": "orchestra.deEscalateTask",
          "when": "view == orchestra.sprintExplorer && viewItem == task-escalated",
          "group": "1_remediation@0"
        },
        {
          "command": "orchestra.moveToGateCheck",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-(escalated|verify_failed)$/",
          "group": "1_remediation@1"
        },
        {
          "command": "orchestra.moveToImplement",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-(escalated|verify_failed)$/",
          "group": "1_remediation@2"
        },
        {
          "command": "orchestra.reopenTask",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-/",
          "group": "1_remediation@3"
        },
        {
          "command": "orchestra.forceComplete",
          "when": "view == orchestra.sprintExplorer && viewItem == task-escalated",
          "group": "2_override"
        },
        {
          "command": "orchestra.runCodeReview",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-complete($|-review-)/",
          "group": "3_review"
        },
        {
          "command": "orchestra.prepareCodeReviewFixTask",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /review-(changes_requested|rejected)$/",
          "group": "3_review@1"
        },
        {
          "command": "orchestra.implementCodeReviewFixTask",
          "when": "view == orchestra.sprintExplorer && viewItem =~ /^task-implement.*review-(changes_requested|rejected)$/",
          "group": "3_review@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run postbuild",
    "build": "node esbuild.config.js --production",
    "postbuild": "node scripts/copy-native-modules.js && node scripts/copy-mcp-server.js",
    "watch": "node esbuild.config.js --watch",
    "package": "npx @vscode/vsce package --no-yarn --out artifacts/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.37.0",
    "zod": "^3.25.76"
  },
  "bundledDependencies": [
    "better-sqlite3",
    "bindings",
    "file-uri-to-path"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "bundleDependencies": [
    "bindings",
    "file-uri-to-path"
  ]
}
