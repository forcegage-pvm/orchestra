{
  "name": "orchestra-extension",
  "displayName": "Orchestra",
  "description": "AI agent task orchestration for VS Code",
  "version": "0.1.0",
  "publisher": "forcegage",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcegage-pvm/orchestra.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "orchestration",
    "ai",
    "agents",
    "task management",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Orchestra",
      "properties": {
        "orchestra.autoStartMCP": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start MCP servers on extension activation"
        },
        "orchestra.updateInterval": {
          "type": "number",
          "default": 500,
          "description": "Database update debounce interval in milliseconds"
        },
        "orchestra.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for Orchestra output channel"
        }
      }
    },
    "commands": [
      {
        "command": "orchestra.openDashboard",
        "title": "Orchestra: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "orchestra.refreshStatus",
        "title": "Orchestra: Refresh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "orchestra.openTaskDetail",
        "title": "Orchestra: Open Task Detail",
        "icon": "$(file-text)"
      },
      {
        "command": "orchestra.invokeOrchestrator",
        "title": "Orchestra: Invoke Orchestrator Agent",
        "icon": "$(robot)"
      },
      {
        "command": "orchestra.invokeImplementor",
        "title": "Orchestra: Invoke Implementor Agent",
        "icon": "$(tools)"
      },
      {
        "command": "orchestra.installMcpServers",
        "title": "Orchestra: Install MCP Servers",
        "icon": "$(plug)"
      },
      {
        "command": "orchestra.initializeWorkspace",
        "title": "Orchestra: Initialize Workspace",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orchestra-explorer",
          "title": "Orchestra",
          "icon": "$(symbol-misc)"
        }
      ]
    },
    "views": {
      "orchestra-explorer": [
        {
          "id": "orchestraSprintExplorer",
          "name": "Sprint Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "orchestraSprintExplorer",
        "contents": "No Orchestra workspace detected.\n\n[Initialize Workspace](command:orchestra.initializeWorkspace)\n\nThis will create the .orchestra folder and database for AI agent task orchestration.",
        "when": "!orchestra.hasWorkspace"
      },
      {
        "view": "orchestraSprintExplorer",
        "contents": "No active sprint.\n\nUse the Orchestra MCP server to configure a sprint, or create one manually.\n\n[Install MCP Servers](command:orchestra.installMcpServers)",
        "when": "orchestra.hasWorkspace && !orchestra.hasActiveSprint"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "orchestra.refreshStatus",
          "when": "view == orchestraSprintExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js --production",
    "postbuild": "node scripts/copy-mcp-server.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
