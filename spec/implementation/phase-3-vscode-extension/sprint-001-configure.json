      "task_id": 1,
      "phase_id": "phase-1-foundation",
      "title": "Extension Scaffold",
      "description": "Create VS Code extension boilerplate with TypeScript, esbuild bundling, and activation events. Deliverables: extension/package.json with extension manifest, extension/tsconfig.json (extends root, targets ES2020), extension/src/extension.ts with activate() and deactivate(), extension/.vscodeignore, extension/esbuild.config.js for bundling, update root package.json scripts: build:extension, watch:extension",
      "category": "INFRASTRUCTURE",
      "dependencies": [],
      "verification": {
        "structural_checks": [
          {
            "description": "extension/package.json exists with valid manifest",
            "severity": "BLOCKING",
            "path": "extension/package.json",
            "pattern": "\"name\":\\s*\"orchestra-extension\"",
            "min_matches": 1
          },
          {
            "description": "extension/tsconfig.json exists and extends root",
            "severity": "BLOCKING",
            "path": "extension/tsconfig.json",
            "pattern": "\"extends\":\\s*\"\\.\\./tsconfig\\.json\"",
            "min_matches": 1
          },
          {
            "description": "extension/src/extension.ts exports activate and deactivate",
            "severity": "BLOCKING",
            "path": "extension/src/extension.ts",
            "pattern": "export\\s+(async\\s+)?function\\s+activate",
            "min_matches": 1
          },
          {
            "description": "extension/.vscodeignore exists",
            "severity": "MAJOR",
            "path": "extension/.vscodeignore"
          },
          {
            "description": "extension/esbuild.config.js exists",
            "severity": "BLOCKING",
            "path": "extension/esbuild.config.js"
          }
        ],
        "behavioral_checks": [
          {
            "description": "TypeScript compiles without errors",
            "severity": "BLOCKING",
            "command": "cd extension && npx tsc --noEmit",
            "expect_exit_code": 0
          },
          {
            "description": "Extension builds successfully",
            "severity": "BLOCKING",
            "command": "cd extension && npm run build",
            "expect_exit_code": 0
          }
        ],
        "quality_checks": [
          {
            "description": "Bundled extension.js is under 500KB",
            "severity": "MAJOR",
            "command": "powershell -Command \"(Get-Item extension/dist/extension.js).Length -lt 512000\"",
            "expect_exit_code": 0
