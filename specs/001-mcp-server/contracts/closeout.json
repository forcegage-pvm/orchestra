{
  "name": "closeout",
  "description": "Verify previous task is properly closed before preparing next (Orchestrator only)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": ["implementor", "orchestrator"],
        "description": "Actor role - must be 'orchestrator' for this tool"
      },
      "taskId": {
        "type": "number",
        "description": "Task ID to verify closeout (optional - uses current if omitted)"
      }
    },
    "required": ["role"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "taskId": { "type": "number" },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "passed": { "type": "boolean" },
            "message": { "type": "string" }
          },
          "required": ["name", "passed"]
        }
      },
      "canProceed": { "type": "boolean" }
    },
    "required": ["success", "taskId", "checks", "canProceed"]
  }
}
