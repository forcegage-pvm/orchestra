{
  "name": "complete",
  "description": "Mark task as complete after successful verification (Orchestrator only)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": ["implementor", "orchestrator"],
        "description": "Actor role - must be 'orchestrator' for this tool"
      },
      "taskId": {
        "type": "number",
        "description": "Task ID to complete (optional - uses current if omitted)"
      }
    },
    "required": ["role"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "taskId": { "type": "number" },
      "previousStatus": { "type": "string" },
      "newStatus": {
        "type": "string",
        "const": "completed"
      },
      "completedAt": { "type": "string", "format": "date-time" },
      "nextTask": {
        "type": ["number", "null"],
        "description": "Next pending task ID, or null if sprint complete"
      }
    },
    "required": [
      "success",
      "taskId",
      "previousStatus",
      "newStatus",
      "completedAt",
      "nextTask"
    ]
  }
}
