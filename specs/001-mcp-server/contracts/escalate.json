{
  "name": "escalate",
  "description": "Escalate persistent failures to human supervisor (Orchestrator only)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": ["implementor", "orchestrator"],
        "description": "Actor role - must be 'orchestrator' for this tool"
      },
      "taskId": {
        "type": "number",
        "description": "Task ID to escalate (optional - uses current if omitted)"
      },
      "reason": {
        "type": "string",
        "description": "Why escalation is needed"
      },
      "context": {
        "type": "string",
        "description": "Additional context for human supervisor"
      }
    },
    "required": ["role", "reason"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "taskId": { "type": "number" },
      "previousStatus": { "type": "string" },
      "newStatus": {
        "type": "string",
        "const": "escalated"
      },
      "escalationPath": { "type": "string" },
      "reportPath": { "type": "string" },
      "attempts": {
        "type": "number",
        "description": "Number of attempts before escalation"
      }
    },
    "required": [
      "success",
      "taskId",
      "previousStatus",
      "newStatus",
      "escalationPath",
      "reportPath",
      "attempts"
    ]
  }
}
