{
  "name": "init",
  "description": "Initialize a new sprint from specification (Orchestrator only)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": ["implementor", "orchestrator"],
        "description": "Actor role - must be 'orchestrator' for this tool"
      },
      "specPath": {
        "type": "string",
        "description": "Path to sprint specification file"
      }
    },
    "required": ["role", "specPath"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "sprintId": { "type": "string" },
      "taskCount": { "type": "number" },
      "orchestraRoot": { "type": "string" }
    },
    "required": ["success", "sprintId", "taskCount", "orchestraRoot"]
  }
}
