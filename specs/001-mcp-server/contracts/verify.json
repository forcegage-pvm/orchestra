{
  "name": "verify",
  "description": "Run hidden verification criteria against task (Orchestrator only - results contain hidden criteria)",
  "inputSchema": {
    "type": "object",
    "properties": {
      "role": {
        "type": "string",
        "enum": ["implementor", "orchestrator"],
        "description": "Actor role - must be 'orchestrator' for this tool"
      },
      "taskId": {
        "type": "number",
        "description": "Task ID to verify (optional - uses current if omitted)"
      }
    },
    "required": ["role"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "taskId": { "type": "number" },
      "passed": { "type": "boolean" },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "criterion": {
              "type": "string",
              "description": "HIDDEN - DO NOT expose to implementor"
            },
            "passed": { "type": "boolean" },
            "details": { "type": "string" }
          },
          "required": ["criterion", "passed"]
        }
      },
      "nextStep": {
        "type": "string",
        "enum": ["complete", "feedback"]
      }
    },
    "required": ["success", "taskId", "passed", "results", "nextStep"]
  }
}
